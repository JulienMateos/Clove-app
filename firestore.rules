rules_version = '2';
// Everything goes through the Cloud Functions (functions/index.js), which use the
// Admin SDK and bypass these rules. Clients may only read — and clear once
// delivered — their own event inbox, forwarded to window.__cloveEvent.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/events/{eventId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
